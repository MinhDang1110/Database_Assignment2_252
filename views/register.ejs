<script>
  /* ── Hiện/ẩn fields Giảng viên khi thay đổi vai trò ─── */
  const roleSelect = document.getElementById('User_role');
  const lecturerFields = ['field-degree', 'field-title', 'field-exp', 'field-degrees'];

  function toggleLecturerFields() {
    const isLecturer = roleSelect.value === 'Lecturer';
    lecturerFields.forEach(function(id) {
      const el = document.getElementById(id);
      if (el) el.style.display = isLecturer ? '' : 'none';
    });
    // Xoá required/value khi ẩn để tránh submit lỗi
    ['Academic_degree', 'Academic_title', 'Teaching_experience'].forEach(function(name) {
      const el = document.querySelector('[name="' + name + '"]');
      if (!el) return;
      if (isLecturer) {
        if (name === 'Academic_degree') el.required = true;
      } else {
        el.required = false;
      }
    });
  }

  function addDegreeRow() {
    var list = document.getElementById('degrees-list');
    var row = document.createElement('div');
    row.className = 'degree-row';
    row.style.cssText = 'display:flex;gap:8px;align-items:center;';
    row.innerHTML =
      '<input type="text" name="degrees[]" class="form-input degree-input"' +
      ' placeholder="Vd: Thạc sĩ Khoa học Máy tính – ĐH Bách Khoa"' +
      ' maxlength="100" style="flex:1;" autofocus>' +
      '<button type="button" class="btn-rm-degree" onclick="removeDegreeRow(this)" title="Xóa dòng này"' +
      ' style="flex-shrink:0;width:36px;height:36px;border-radius:8px;border:1px solid rgba(251,113,133,0.4);' +
      'background:rgba(251,113,133,0.08);color:#fb7185;cursor:pointer;display:flex;align-items:center;justify-content:center;">' +
      '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">' +
      '<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>';
    list.appendChild(row);
    row.querySelector('input').focus();
  }

  function removeDegreeRow(btn) {
    var row = btn.closest('.degree-row');
    if (row) row.remove();
  }

  roleSelect.addEventListener('change', toggleLecturerFields);

  // Chạy ngay khi load (trường hợp form re-populate sau lỗi)
  toggleLecturerFields();

  /* ── Toggle Password Visibility ────────────────────────── */
  document.querySelectorAll('.toggle-password').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const input = this.parentElement.querySelector('input');
      const isPassword = input.type === 'password';
      input.type = isPassword ? 'text' : 'password';

      // Update icon (optional: you could switch between eye and eye-off)
      this.style.color = isPassword ? 'var(--indigo-600)' : 'var(--txt-muted)';
    });
  });

  /* ── Submit: validation & loading state ────────────────── */
  document.getElementById('register-form').addEventListener('submit', function(e) {
    const password = document.getElementById('Password').value;
    const confirm = document.getElementById('Confirm_password').value;

    if (password !== confirm) {
      e.preventDefault();
      alert('Mật khẩu xác nhận không khớp. Vui lòng kiểm tra lại.');
      return;
    }

    const btn = document.getElementById('btn-submit');
    btn.disabled = true;
    btn.textContent = 'Đang tạo tài khoản…';
  });
</script>
</body>
</html>
