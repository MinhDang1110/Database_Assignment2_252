<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>LMS EduGate – Trang học tập</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

  <style>
    /* ─── TOKENS ────────────────────────────────────────── */
    :root {
      --indigo-900: #1e1b4b;
      --indigo-800: #2e2a6e;
      --indigo-700: #3730a3;
      --indigo-600: #4f46e5;
      --indigo-500: #6366f1;
      --indigo-400: #818cf8;
      --indigo-300: #a5b4fc;
      --indigo-100: #e0e7ff;
      --violet-500: #8b5cf6;
      --violet-400: #a78bfa;
      --teal-400:   #2dd4bf;
      --teal-300:   #5eead4;
      --amber-400:  #fbbf24;
      --emerald-400:#34d399;
      --rose-400:   #fb7185;

      /* Surfaces */
      --bg-page:    #f4f6ff;
      --bg-card:    #ffffff;
      --bg-soft:    #f8f9ff;
      --bg-nav:     #0d0b1e;

      /* Text */
      --txt-head:   #0d0c22;
      --txt-body:   #374151;
      --txt-soft:   #6b7280;
      --txt-muted:  #9ca3af;
      --txt-light:  #f1f0fe;

      /* Borders */
      --border:     #e5e7f0;
      --border-soft:#eef0f8;

      /* Shadows */
      --shadow-sm:  0 2px 8px rgba(15,23,42,0.06);
      --shadow-md:  0 8px 24px rgba(15,23,42,0.08);
      --shadow-lg:  0 20px 48px rgba(15,23,42,0.10);
      --shadow-indigo: 0 10px 28px rgba(99,102,241,0.28);

      /* Radii */
      --r-xs: 8px;
      --r-sm: 12px;
      --r-md: 18px;
      --r-lg: 24px;
      --r-xl: 30px;
    }

    /* ─── RESET ─────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      font-family: "Be Vietnam Pro", "Segoe UI", system-ui, sans-serif;
      background: var(--bg-page);
      color: var(--txt-body);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: geometricPrecision;
      line-height: 1.6;
      letter-spacing: -0.01em;
      min-height: 100vh;
    }

    h1, h2, h3, .hero-title, .section-title, .stat-value, .course-title {
      font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
      letter-spacing: -0.035em;
      color: var(--txt-head);
    }

    p, .course-desc, .stat-label, .meta, .nav-pill, .btn, input, select, textarea {
      letter-spacing: -0.012em;
    }

    /* ─── PAGE WRAPPER ───────────────────────────────────── */
    .page-root {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    /* ─── TOP NAVIGATION BAR ─────────────────────────────── */
    .topnav {
      background:
        radial-gradient(ellipse 70% 100% at 0% 50%, rgba(99,102,241,0.20) 0%, transparent 55%),
        radial-gradient(ellipse 50% 80% at 100% 50%, rgba(139,92,246,0.16) 0%, transparent 50%),
        #0d0b1e;
      border-bottom: 1px solid rgba(255,255,255,0.07);
      padding: 0 28px;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 4px 24px rgba(0,0,0,0.22);
    }

    /* Grid-line texture on nav */
    .topnav::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,0.022) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.022) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
    }

    .nav-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      position: relative;
      flex-shrink: 0;
    }

    .nav-logo {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 55%, #2dd4bf 100%);
      display: grid;
      place-items: center;
      font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
      font-weight: 800;
      font-size: 17px;
      color: white;
      box-shadow: 0 6px 18px rgba(99,102,241,0.50), inset 0 1px 0 rgba(255,255,255,0.22);
      flex-shrink: 0;
    }

    .nav-wordmark {
      font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
      font-size: 16px;
      font-weight: 700;
      color: #f1f0fe;
      letter-spacing: -0.01em;
    }

    .nav-wordmark small {
      display: block;
      font-size: 11px;
      color: #6b7191;
      font-weight: 400;
      margin-top: 1px;
      font-family: "Be Vietnam Pro", sans-serif;
    }

    .nav-center {
      display: flex;
      align-items: center;
      gap: 4px;
      position: relative;
    }

    .nav-pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 14px;
      border-radius: 10px;
      font-size: 13.5px;
      font-weight: 600;
      color: rgba(255,255,255,0.55);
      text-decoration: none;
      transition: background 0.18s, color 0.18s;
    }

    .nav-pill:hover { background: rgba(255,255,255,0.07); color: #f1f0fe; }
    .nav-pill.active { background: rgba(99,102,241,0.20); color: #a5b4fc; }

    .nav-pill svg { width: 16px; height: 16px; flex-shrink: 0; }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
      position: relative;
    }

    /* Greeting chip */
    .user-chip {
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 6px 14px 6px 6px;
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.10);
      border-radius: 999px;
      cursor: default;
    }

    .user-avatar {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: linear-gradient(135deg, #6366f1, #2dd4bf);
      display: grid;
      place-items: center;
      font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
      font-size: 13px;
      font-weight: 700;
      color: white;
      flex-shrink: 0;
    }

    .user-name {
      font-size: 13.5px;
      font-weight: 600;
      color: #e2e0fc;
    }

    .role-pill {
      display: inline-block;
      background: rgba(99,102,241,0.22);
      border: 1px solid rgba(99,102,241,0.35);
      color: var(--indigo-300);
      border-radius: 999px;
      padding: 2px 9px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    .btn-nav {
      height: 36px;
      padding: 0 16px;
      border-radius: 10px;
      font-family: inherit;
      font-size: 13.5px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.18s, transform 0.16s, box-shadow 0.18s;
      border: none;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .btn-nav:active { transform: scale(0.97); }

    .btn-nav-ghost {
      background: rgba(255,255,255,0.07);
      color: rgba(255,255,255,0.75);
      border: 1px solid rgba(255,255,255,0.10);
    }
    .btn-nav-ghost:hover { background: rgba(255,255,255,0.12); color: #fff; }

    .btn-nav-danger {
      background: rgba(251,113,133,0.14);
      color: #fda4af;
      border: 1px solid rgba(251,113,133,0.22);
    }
    .btn-nav-danger:hover { background: rgba(251,113,133,0.22); color: #fff; }

    /* ─── MAIN CONTENT ───────────────────────────────────── */
    .main-content {
      flex: 1;
      padding: 32px 28px 48px;
      max-width: 1320px;
      margin: 0 auto;
      width: 100%;
    }

    /* ─── ALERTS ─────────────────────────────────────────── */
    .alert-bar {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      border-radius: var(--r-md);
      padding: 13px 16px;
      border: 1px solid transparent;
      font-size: 14px;
      line-height: 1.5;
      margin-bottom: 20px;
      animation: alert-in 0.35s cubic-bezier(0.16,1,0.3,1);
    }

    @keyframes alert-in {
      from { opacity: 0; transform: translateY(-8px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .alert-bar-success {
      background: #f0fdf4;
      border-color: #86efac;
      color: #166534;
    }

    .alert-bar-danger {
      background: #fff1f2;
      border-color: #fda4af;
      color: #be123c;
    }

    .alert-icon {
      flex-shrink: 0;
      width: 18px;
      height: 18px;
      margin-top: 1px;
    }

    /* ─── HERO BANNER ────────────────────────────────────── */
    .hero-banner {
      border-radius: var(--r-xl);
      padding: 36px 40px;
      margin-bottom: 24px;
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(ellipse 80% 120% at 0% 0%, rgba(99,102,241,0.30) 0%, transparent 55%),
        radial-gradient(ellipse 60% 100% at 100% 100%, rgba(139,92,246,0.28) 0%, transparent 50%),
        radial-gradient(ellipse 40% 60% at 60% 20%, rgba(45,212,191,0.12) 0%, transparent 40%),
        #0f0d26;
      box-shadow: 0 24px 60px rgba(13,11,30,0.28);
      border: 1px solid rgba(255,255,255,0.07);
      animation: hero-in 0.65s cubic-bezier(0.16,1,0.3,1) both;
    }

    @keyframes hero-in {
      from { opacity: 0; transform: translateY(18px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* Grid lines */
    .hero-banner::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,0.022) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.022) 1px, transparent 1px);
      background-size: 48px 48px;
      pointer-events: none;
    }

    /* Orb decorations */
    .hero-banner::after {
      content: "";
      position: absolute;
      right: -80px;
      top: -80px;
      width: 320px;
      height: 320px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(99,102,241,0.20) 0%, transparent 70%);
      pointer-events: none;
    }

    .hero-inner {
      position: relative;
      z-index: 2;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 20px;
      flex-wrap: wrap;
    }

    .hero-text { max-width: 680px; }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(99,102,241,0.18);
      border: 1px solid rgba(99,102,241,0.30);
      color: var(--indigo-300);
      border-radius: 999px;
      padding: 6px 14px;
      font-size: 12.5px;
      font-weight: 600;
      margin-bottom: 16px;
      backdrop-filter: blur(6px);
    }

    .badge-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--teal-400);
      box-shadow: 0 0 8px rgba(45,212,191,0.9);
      animation: blink 2.4s ease-in-out infinite;
    }

    @keyframes blink {
      0%,100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(0.7); }
    }

    .hero-title {
      font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
      font-size: clamp(26px, 3.2vw, 40px);
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1.1;
      color: #f1f0fe;
      margin-bottom: 10px;
    }

    .hero-title .gradient-text {
      background: linear-gradient(90deg, #818cf8, #a78bfa 40%, #2dd4bf);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-subtitle {
      color: #7b83a8;
      font-size: 14.5px;
      line-height: 1.75;
      max-width: 600px;
    }

    .hero-cta-row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
    }

    .hero-stat-mini {
      display: flex;
      align-items: center;
      gap: 8px;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.09);
      border-radius: 14px;
      padding: 10px 18px;
    }

    .hero-stat-mini strong {
      font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
      font-size: 22px;
      font-weight: 800;
      color: #f1f0fe;
      letter-spacing: -0.02em;
    }

    .hero-stat-mini span {
      font-size: 12px;
      color: #7b83a8;
      line-height: 1.4;
      max-width: 60px;
    }

    /* ─── SECTION STRUCTURE ──────────────────────────────── */
    .section-gap { margin-bottom: 28px; }

    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }

    .section-label {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .section-label-bar {
      width: 3px;
      height: 22px;
      border-radius: 2px;
      background: linear-gradient(180deg, #6366f1, #2dd4bf);
    }

    .section-title {
      font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
      font-size: 20px;
      font-weight: 800;
      letter-spacing: -0.025em;
      color: var(--txt-head);
    }

    /* ─── STAT CARDS ─────────────────────────────────────── */
    .stat-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px;
      margin-bottom: 28px;
    }

    .stat-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      padding: 20px 22px;
      box-shadow: var(--shadow-sm);
      position: relative;
      overflow: hidden;
      transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
      animation: card-in 0.55s cubic-bezier(0.16,1,0.3,1) both;
    }

    .stat-card:nth-child(1) { animation-delay: 0.10s; }
    .stat-card:nth-child(2) { animation-delay: 0.17s; }
    .stat-card:nth-child(3) { animation-delay: 0.24s; }
    .stat-card:nth-child(4) { animation-delay: 0.31s; }

    @keyframes card-in {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .stat-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
      border-color: rgba(99,102,241,0.22);
    }

    /* Colored top stripe per card */
    .stat-card::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      border-radius: 2px 2px 0 0;
    }

    .stat-card:nth-child(1)::before { background: linear-gradient(90deg, #6366f1, #818cf8); }
    .stat-card:nth-child(2)::before { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
    .stat-card:nth-child(3)::before { background: linear-gradient(90deg, #10b981, #34d399); }
    .stat-card:nth-child(4)::before { background: linear-gradient(90deg, #8b5cf6, #a78bfa); }

    .stat-icon {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      margin-bottom: 14px;
      font-size: 19px;
    }

    .stat-icon-indigo { background: rgba(99,102,241,0.10); color: var(--indigo-500); }
    .stat-icon-amber  { background: rgba(245,158,11,0.10); color: #f59e0b; }
    .stat-icon-emerald{ background: rgba(16,185,129,0.10); color: #10b981; }
    .stat-icon-violet { background: rgba(139,92,246,0.10); color: var(--violet-500); }

    .stat-value {
      font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
      font-size: 34px;
      font-weight: 800;
      letter-spacing: -0.04em;
      color: var(--txt-head);
      line-height: 1;
      margin-bottom: 6px;
    }

    .stat-label {
      font-size: 13px;
      font-weight: 700;
      color: var(--txt-soft);
      margin-bottom: 4px;
    }

    .stat-hint {
      font-size: 12px;
      color: var(--txt-muted);
    }

    /* ─── FILTER PILLS ───────────────────────────────────── */
    .filter-pill-group {
      display: flex;
      gap: 6px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      padding: 5px;
      border-radius: 14px;
      box-shadow: var(--shadow-sm);
    }

    .filter-pill {
      border-radius: 10px;
      padding: 7px 16px;
      font-size: 13.5px;
      font-weight: 600;
      text-decoration: none;
      color: var(--txt-soft);
      transition: background 0.18s, color 0.18s, box-shadow 0.18s;
      white-space: nowrap;
    }

    .filter-pill:hover {
      background: var(--bg-soft);
      color: var(--indigo-600);
    }

    .filter-pill.active {
      background: var(--indigo-600);
      color: #ffffff;
      box-shadow: 0 6px 18px rgba(99,102,241,0.30);
    }

    /* ─── COURSE GRID ────────────────────────────────────── */
    .course-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
      margin-bottom: 28px;
    }

    .course-card {
      background: var(--bg-card);
      border: 1.5px solid var(--border);
      border-radius: var(--r-lg);
      padding: 22px;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
      min-height: 280px;
      position: relative;
      overflow: hidden;
      animation: card-in 0.55s cubic-bezier(0.16,1,0.3,1) both;
    }

    .course-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lg);
      border-color: rgba(99,102,241,0.30);
    }

    /* Subtle gradient glow on hover */
    .course-card::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: linear-gradient(135deg, rgba(99,102,241,0.04), rgba(139,92,246,0.03));
      opacity: 0;
      transition: opacity 0.28s ease;
      pointer-events: none;
    }

    .course-card:hover::after { opacity: 1; }

    .course-card-top {
      display: flex;
      gap: 14px;
      margin-bottom: 16px;
    }

    .course-icon {
      width: 50px;
      height: 50px;
      border-radius: 16px;
      background: linear-gradient(135deg, rgba(99,102,241,0.15), rgba(139,92,246,0.10));
      border: 1px solid rgba(99,102,241,0.14);
      color: var(--indigo-500);
      display: grid;
      place-items: center;
      font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
      font-weight: 800;
      font-size: 20px;
      flex-shrink: 0;
    }

    .course-info { flex: 1; min-width: 0; }

    .course-name {
      font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
      font-size: 16.5px;
      font-weight: 700;
      color: var(--txt-head);
      margin-bottom: 5px;
      line-height: 1.35;
      letter-spacing: -0.01em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .course-desc {
      font-size: 13.5px;
      color: var(--txt-soft);
      line-height: 1.55;
      display: -webkit-box; /* Đảm bảo sử dụng WebKit */
      -webkit-line-clamp: 2; /* Chrome, Safari */
      -webkit-box-orient: vertical; /* Chrome, Safari */
      overflow: hidden;

      /* Thêm line-clamp chuẩn (nếu trình duyệt hỗ trợ) */
      line-clamp: 2; /* Chuẩn, hỗ trợ các trình duyệt hiện đại */
    }

    /* Meta grid */
    .course-meta {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      margin-bottom: 16px;
    }

    .meta-item {
      background: var(--bg-soft);
      border: 1px solid var(--border-soft);
      border-radius: var(--r-sm);
      padding: 10px 12px;
    }

    .meta-label {
      font-size: 11px;
      color: var(--txt-muted);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 3px;
    }

    .meta-value {
      font-size: 13px;
      color: var(--txt-head);
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Progress */
    .course-progress { margin-top: auto; }

    .progress-line {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      color: var(--txt-soft);
      margin-bottom: 8px;
    }

    .progress-line strong {
      font-weight: 700;
      color: var(--indigo-600);
    }

    .progress-track {
      height: 8px;
      border-radius: 999px;
      background: var(--bg-soft);
      border: 1px solid var(--border-soft);
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, #6366f1, #8b5cf6 50%, #2dd4bf);
      transition: width 1.2s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
    }

    /* Shimmer on progress */
    .progress-fill::after {
      content: "";
      position: absolute;
      top: 0; left: -100%; right: 0; bottom: 0;
      background: linear-gradient(90deg, transparent 30%, rgba(255,255,255,0.45) 50%, transparent 70%);
      animation: shimmer 2.2s ease-in-out infinite;
    }

    @keyframes shimmer {
      from { left: -100%; }
      to   { left: 100%; }
    }

    /* Course actions row */
    .course-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-top: 16px;
    }

    /* Status badges */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border-radius: 999px;
      padding: 5px 12px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.01em;
    }

    .status-badge::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .status-active {
      background: rgba(245,158,11,0.12);
      color: #b45309;
      border: 1px solid rgba(245,158,11,0.22);
    }
    .status-active::before { background: #f59e0b; box-shadow: 0 0 6px rgba(245,158,11,0.7); }

    .status-completed {
      background: rgba(16,185,129,0.12);
      color: #065f46;
      border: 1px solid rgba(16,185,129,0.22);
    }
    .status-completed::before { background: #10b981; }

    .status-dropped {
      background: rgba(239,68,68,0.10);
      color: #991b1b;
      border: 1px solid rgba(239,68,68,0.18);
    }
    .status-dropped::before { background: #ef4444; }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      border-radius: var(--r-sm);
      padding: 9px 18px;
      font-family: inherit;
      font-size: 13.5px;
      font-weight: 700;
      cursor: pointer;
      border: none;
      text-decoration: none;
      transition: transform 0.18s, box-shadow 0.18s, background 0.18s;
    }

    .btn:active { transform: scale(0.97); }

    .btn-primary {
      background: linear-gradient(135deg, #4f46e5, #6366f1 50%, #8b5cf6);
      color: white;
      box-shadow: 0 8px 22px rgba(99,102,241,0.30);
    }

    .btn-primary:hover {
      box-shadow: 0 12px 28px rgba(99,102,241,0.42);
      transform: translateY(-1px);
    }

    .btn-ghost {
      background: var(--bg-soft);
      color: var(--txt-soft);
      border: 1.5px solid var(--border);
    }

    .btn-ghost:hover {
      background: var(--border-soft);
      color: var(--txt-head);
    }

    .btn-success {
      background: linear-gradient(135deg, #059669, #10b981);
      color: white;
      box-shadow: 0 6px 18px rgba(16,185,129,0.28);
      padding: 7px 16px;
      font-size: 13px;
    }

    .btn-success:hover {
      box-shadow: 0 8px 22px rgba(16,185,129,0.40);
      transform: translateY(-1px);
    }

    /* ─── EMPTY STATE ────────────────────────────────────── */
    .empty-card {
      background: var(--bg-card);
      border: 1.5px dashed #d1d5e0;
      border-radius: var(--r-lg);
      padding: 52px 32px;
      text-align: center;
      margin-bottom: 28px;
    }

    .empty-icon {
      width: 60px;
      height: 60px;
      border-radius: 18px;
      background: rgba(99,102,241,0.08);
      display: grid;
      place-items: center;
      margin: 0 auto 16px;
      font-size: 26px;
    }

    .empty-title {
      font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
      font-size: 17px;
      font-weight: 700;
      color: var(--txt-head);
      margin-bottom: 6px;
    }

    .empty-body {
      color: var(--txt-muted);
      font-size: 14px;
    }

    /* ─── AVAILABLE COURSES TABLE ────────────────────────── */
    .table-section {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--r-xl);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
    }

    .table-section-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      padding: 20px 24px 16px;
      border-bottom: 1px solid var(--border-soft);
      flex-wrap: wrap;
    }

    .table-title-group { display: flex; align-items: center; gap: 10px; }

    .table-title {
      font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
      font-size: 18px;
      font-weight: 800;
      color: var(--txt-head);
      letter-spacing: -0.02em;
    }

    .table-count {
      background: rgba(99,102,241,0.10);
      color: var(--indigo-600);
      border-radius: 999px;
      padding: 3px 10px;
      font-size: 12px;
      font-weight: 700;
    }

    .data-table {
      width: 100%;
      border-collapse: collapse;
    }

    .data-table thead tr {
      background: #0d0b1e;
      position: relative;
    }

    .data-table thead th {
      padding: 13px 18px;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: rgba(255,255,255,0.60);
      text-align: left;
      white-space: nowrap;
    }

    .data-table thead th:first-child { color: rgba(255,255,255,0.40); }

    .data-table tbody tr {
      border-bottom: 1px solid var(--border-soft);
      transition: background 0.16s;
    }

    .data-table tbody tr:last-child { border-bottom: none; }
    .data-table tbody tr:hover { background: rgba(99,102,241,0.03); }

    .data-table tbody td {
      padding: 14px 18px;
      font-size: 14px;
      color: var(--txt-body);
      vertical-align: middle;
    }

    .td-id {
      color: var(--txt-muted);
      font-size: 12.5px;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
    }

    .course-name-cell strong {
      display: block;
      font-weight: 700;
      color: var(--txt-head);
      font-size: 13.5px;
    }

    .course-name-cell small {
      font-size: 12px;
      color: var(--txt-muted);
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .credit-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      border-radius: 8px;
      background: rgba(99,102,241,0.10);
      color: var(--indigo-600);
      font-size: 12.5px;
      font-weight: 700;
    }

    .empty-table-row td {
      padding: 40px 18px;
      text-align: center;
      color: var(--txt-muted);
      font-size: 14px;
    }

    /* ─── RESPONSIVE ─────────────────────────────────────── */
    @media (max-width: 1100px) {
      .stat-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 900px) {
      .course-grid { grid-template-columns: 1fr; }
      .hero-title  { font-size: 26px; }
      .nav-center  { display: none; }
    }

    @media (max-width: 768px) {
      .main-content { padding: 20px 16px 40px; }
      .topnav { padding: 0 16px; }
      .hero-banner { padding: 26px 22px; }
      .hero-stat-mini { display: none; }
      .stat-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
      .data-table thead th:nth-child(3),
      .data-table tbody td:nth-child(3),
      .data-table thead th:nth-child(4),
      .data-table tbody td:nth-child(4) { display: none; }
    }

    @media (max-width: 520px) {
      .stat-grid { grid-template-columns: 1fr 1fr; }
      .user-name, .role-pill { display: none; }
      .filter-pill-group { overflow-x: auto; }
      .course-meta { grid-template-columns: 1fr; }
      .course-actions { flex-direction: column; align-items: stretch; }
      .course-actions .btn { justify-content: center; }
      .nav-wordmark small { display: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation: none !important; transition: none !important; }
    }

    /* ─── COURSE DETAIL MODAL ────────────────────────────── */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(10, 8, 28, 0.72);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.25s ease, visibility 0.25s ease;
    }

    .modal-overlay.is-open {
      opacity: 1;
      visibility: visible;
    }

    .modal-box {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--r-xl);
      box-shadow: 0 32px 80px rgba(10,8,28,0.30), 0 0 0 1px rgba(99,102,241,0.08);
      width: 100%;
      max-width: 780px;
      max-height: 88vh;
      display: flex;
      flex-direction: column;
      transform: translateY(24px) scale(0.97);
      transition: transform 0.28s cubic-bezier(0.16,1,0.3,1);
      overflow: hidden;
    }

    .modal-overlay.is-open .modal-box {
      transform: translateY(0) scale(1);
    }

    /* Modal Header */
    .modal-header {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      padding: 24px 26px 20px;
      border-bottom: 1px solid var(--border-soft);
      flex-shrink: 0;
      background:
        radial-gradient(ellipse 80% 120% at 0% 0%, rgba(99,102,241,0.07) 0%, transparent 60%),
        var(--bg-card);
    }

    .modal-course-icon {
      width: 52px;
      height: 52px;
      border-radius: 16px;
      background: linear-gradient(135deg, rgba(99,102,241,0.15), rgba(139,92,246,0.12));
      border: 1px solid rgba(99,102,241,0.18);
      color: var(--indigo-600);
      display: grid;
      place-items: center;
      font-family: "Plus Jakarta Sans", sans-serif;
      font-weight: 800;
      font-size: 22px;
      flex-shrink: 0;
    }

    .modal-title-block { flex: 1; min-width: 0; }

    .modal-course-name {
      font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
      font-size: 20px;
      font-weight: 800;
      color: var(--txt-head);
      letter-spacing: -0.025em;
      line-height: 1.25;
      margin-bottom: 6px;
    }

    .modal-course-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .modal-tag {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      border-radius: 999px;
      padding: 3px 10px;
      font-size: 12px;
      font-weight: 600;
    }

    .modal-tag-indigo {
      background: rgba(99,102,241,0.10);
      color: var(--indigo-600);
      border: 1px solid rgba(99,102,241,0.18);
    }

    .modal-tag-violet {
      background: rgba(139,92,246,0.10);
      color: var(--violet-500);
      border: 1px solid rgba(139,92,246,0.18);
    }

    .modal-tag-teal {
      background: rgba(45,212,191,0.10);
      color: #0d9488;
      border: 1px solid rgba(45,212,191,0.22);
    }

    .modal-close-btn {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: var(--bg-soft);
      border: 1px solid var(--border);
      color: var(--txt-soft);
      cursor: pointer;
      display: grid;
      place-items: center;
      flex-shrink: 0;
      transition: background 0.16s, color 0.16s, transform 0.16s;
      margin-top: 2px;
    }

    .modal-close-btn:hover {
      background: rgba(239,68,68,0.08);
      border-color: rgba(239,68,68,0.20);
      color: #ef4444;
      transform: scale(1.05);
    }

    /* Modal Body */
    .modal-body {
      flex: 1;
      overflow-y: auto;
      padding: 22px 26px 26px;
      scrollbar-width: thin;
      scrollbar-color: #e0e7ff transparent;
    }

    .modal-body::-webkit-scrollbar { width: 5px; }
    .modal-body::-webkit-scrollbar-track { background: transparent; }
    .modal-body::-webkit-scrollbar-thumb { background: #d1d5e0; border-radius: 4px; }

    /* Info grid */
    .modal-info-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-bottom: 22px;
    }

    .modal-info-item {
      background: var(--bg-soft);
      border: 1px solid var(--border-soft);
      border-radius: var(--r-sm);
      padding: 12px 14px;
    }

    .modal-info-label {
      font-size: 11px;
      font-weight: 700;
      color: var(--txt-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 5px;
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .modal-info-value {
      font-size: 13.5px;
      font-weight: 600;
      color: var(--txt-head);
      line-height: 1.4;
    }

    /* Description */
    .modal-desc-block {
      background: var(--bg-soft);
      border: 1px solid var(--border-soft);
      border-radius: var(--r-sm);
      padding: 14px 16px;
      margin-bottom: 22px;
      font-size: 14px;
      color: var(--txt-body);
      line-height: 1.7;
    }

    /* Section titles */
    .modal-section-title {
      font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
      font-size: 14px;
      font-weight: 800;
      color: var(--txt-head);
      letter-spacing: -0.01em;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .modal-section-title::after {
      content: "";
      flex: 1;
      height: 1px;
      background: var(--border-soft);
    }

    /* Chapter accordion */
    .chapter-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 22px;
    }

    .chapter-item {
      border: 1px solid var(--border);
      border-radius: var(--r-sm);
      overflow: hidden;
      transition: border-color 0.18s;
    }

    .chapter-item:hover { border-color: rgba(99,102,241,0.25); }

    .chapter-header {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      cursor: pointer;
      background: var(--bg-soft);
      user-select: none;
      transition: background 0.16s;
    }

    .chapter-header:hover { background: rgba(99,102,241,0.04); }

    .chapter-num {
      width: 26px;
      height: 26px;
      border-radius: 8px;
      background: linear-gradient(135deg, #6366f1, #8b5cf6);
      color: white;
      font-size: 12px;
      font-weight: 700;
      display: grid;
      place-items: center;
      flex-shrink: 0;
    }

    .chapter-name {
      flex: 1;
      font-size: 14px;
      font-weight: 700;
      color: var(--txt-head);
    }

    .chapter-lecture-count {
      font-size: 12px;
      color: var(--txt-muted);
      font-weight: 600;
    }

    .chapter-chevron {
      width: 18px;
      height: 18px;
      color: var(--txt-muted);
      transition: transform 0.22s ease;
      flex-shrink: 0;
    }

    .chapter-item.is-open .chapter-chevron {
      transform: rotate(180deg);
    }

    .chapter-lectures {
      display: none;
      padding: 0 14px 12px 52px;
      background: var(--bg-card);
    }

    .chapter-item.is-open .chapter-lectures {
      display: block;
    }

    .lecture-row {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 0;
      border-bottom: 1px solid var(--border-soft);
      font-size: 13.5px;
      color: var(--txt-body);
    }

    .lecture-row:last-child { border-bottom: none; }

    .lecture-row svg {
      color: var(--indigo-400);
      flex-shrink: 0;
    }

    .lecture-empty {
      font-size: 13px;
      color: var(--txt-muted);
      padding: 8px 0;
      font-style: italic;
    }

    /* Quiz list */
    .quiz-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 22px;
    }

    .quiz-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      background: var(--bg-soft);
      border: 1px solid var(--border-soft);
      border-radius: var(--r-sm);
      transition: border-color 0.18s;
    }

    .quiz-row:hover { border-color: rgba(245,158,11,0.30); }

    .quiz-icon {
      width: 32px;
      height: 32px;
      border-radius: 9px;
      background: rgba(245,158,11,0.10);
      color: #f59e0b;
      display: grid;
      place-items: center;
      flex-shrink: 0;
    }

    .quiz-info { flex: 1; min-width: 0; }

    .quiz-title {
      font-size: 13.5px;
      font-weight: 700;
      color: var(--txt-head);
      margin-bottom: 2px;
    }

    .quiz-meta-row {
      display: flex;
      gap: 12px;
      font-size: 12px;
      color: var(--txt-muted);
    }

    /* Prerequisites */
    .prereq-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 22px;
    }

    .prereq-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(251,113,133,0.08);
      border: 1px solid rgba(251,113,133,0.22);
      color: #be123c;
      border-radius: 999px;
      padding: 6px 14px;
      font-size: 13px;
      font-weight: 600;
    }

    .prereq-none {
      font-size: 13.5px;
      color: var(--txt-muted);
      font-style: italic;
      margin-bottom: 22px;
    }

    /* Dates */
    .modal-dates-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 10px;
    }

    .modal-date-card {
      border-radius: var(--r-sm);
      padding: 14px 16px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .modal-date-card-start {
      background: rgba(99,102,241,0.06);
      border: 1px solid rgba(99,102,241,0.16);
    }

    .modal-date-card-end {
      background: rgba(45,212,191,0.06);
      border: 1px solid rgba(45,212,191,0.18);
    }

    .modal-date-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      font-size: 17px;
      flex-shrink: 0;
    }

    .modal-date-icon-start { background: rgba(99,102,241,0.12); }
    .modal-date-icon-end   { background: rgba(45,212,191,0.12); }

    .modal-date-label {
      font-size: 11px;
      font-weight: 700;
      color: var(--txt-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 3px;
    }

    .modal-date-value {
      font-size: 14px;
      font-weight: 700;
      color: var(--txt-head);
    }

    /* Loading / Error state */
    .modal-loading {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      padding: 48px 24px;
      color: var(--txt-muted);
      font-size: 14px;
    }

    .modal-spinner {
      width: 36px;
      height: 36px;
      border: 3px solid var(--border);
      border-top-color: var(--indigo-500);
      border-radius: 50%;
      animation: spin 0.75s linear infinite;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    /* Button Xem chi tiết */
    .btn-detail {
      background: var(--bg-soft);
      color: var(--indigo-600);
      border: 1.5px solid rgba(99,102,241,0.25);
      font-size: 13px;
      padding: 7px 14px;
    }

    .btn-detail:hover {
      background: rgba(99,102,241,0.07);
      border-color: rgba(99,102,241,0.45);
      color: var(--indigo-700);
    }

    @media (max-width: 640px) {
      .modal-info-grid { grid-template-columns: repeat(2, 1fr); }
      .modal-dates-grid { grid-template-columns: 1fr; }
      .modal-box { max-height: 94vh; }
    }
  </style>
</head>

<body>

  
<% 
  var user = typeof currentUser !== 'undefined' ? currentUser : null;

  // enrolledCourses = danh sách đang hiển thị theo filter hiện tại.
  // allEnrolledCourses = toàn bộ khóa học sinh viên đã đăng ký, dùng riêng cho card thống kê tổng.
  var rawEnrolledCourses = typeof enrolledCourses !== 'undefined' ? enrolledCourses : [];
  var rawAllEnrolledCourses = typeof allEnrolledCourses !== 'undefined' ? allEnrolledCourses : [];
  var rawAvailableCourses = typeof availableCourses !== 'undefined' ? availableCourses : [];

  var myCourses = Array.isArray(rawEnrolledCourses) ? rawEnrolledCourses : [];
  var allCourses = Array.isArray(rawAllEnrolledCourses) ? rawAllEnrolledCourses : myCourses;
  var courseList = Array.isArray(rawAvailableCourses) ? rawAvailableCourses : [];

  var successMessage = typeof success !== 'undefined' ? success : null;
  var errorMessage = typeof error !== 'undefined' ? error : null;
  var statusFilter = typeof selectedStatus !== 'undefined' ? selectedStatus : 'active';

  var totalMyCourses = myCourses.length;
  var completedCount = allCourses.filter(function(c) {
    return String(c.Enroll_status || '').trim() === 'Completed';
  }).length;
  var activeCount = allCourses.filter(function(c) {
    return String(c.Enroll_status || '').trim() === 'Enrolled';
  }).length;
  var availableCount = courseList.length;

  // Hàm tính toán tiến độ với bảo vệ kiểm tra dữ liệu
  function getProgressPercent(c) {
    const totalItems = (Number(c.Total_lectures || 0) + Number(c.Total_quizzes || 0));
    const completedItems = (Number(c.Completed_lectures || 0) + Number(c.Passed_quizzes || 0));
    if (totalItems === 0) return 0;
    return Math.round(completedItems * 10000 / totalItems) / 100;
  }

  function getCompletedItems(c) {
    return (Number(c.Completed_lectures || 0) + Number(c.Passed_quizzes || 0));
  }

  function getTotalItems(c) {
    return (Number(c.Total_lectures || 0) + Number(c.Total_quizzes || 0));
  }
%>
