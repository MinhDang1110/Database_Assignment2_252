                      <% if (isClosingSoon) { %>
                        <span style="display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:8px;background:#fffbeb;border:1px solid #fcd34d;color:#92400e;font-size:12px;font-weight:600;">
