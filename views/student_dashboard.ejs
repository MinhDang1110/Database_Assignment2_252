                        action="/student/courses/<%= c.Course_ID %>/enroll"
                        onsubmit="<% if (isClosingSoon) { %>return confirm('⚠️ Khóa học sắp bị đóng lại (còn <%= daysLeft %> ngày)!\n\nBạn vẫn muốn đăng ký khóa học: <%= c.Course_name %>?');<% } else { %>return confirm('Bạn muốn đăng ký khóa học: <%= c.Course_name %>?');<% } %>"
                        style="margin:0;"
                      >
                        <button class="btn btn-success" type="submit">
                          Đăng ký
                        </button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

    </section>

  </main>
</div><!-- end .page-root -->

<!-- ══════════════════════════════════════════════
     COURSE DETAIL MODAL
══════════════════════════════════════════════ -->
<div
  class="modal-overlay"
  id="courseDetailModal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modalCourseTitle"
  onclick="handleModalOverlayClick(event)"
>
  <div class="modal-box" id="modalBox">

    <!-- Header -->
    <div class="modal-header">
      <div class="modal-course-icon" id="modalCourseIcon">?</div>
      <div class="modal-title-block">
        <div class="modal-course-name" id="modalCourseTitle">Đang tải...</div>
        <div class="modal-course-tags" id="modalCourseTags"></div>
      </div>
      <button
        class="modal-close-btn"
        onclick="closeModal()"
        aria-label="Đóng"
        title="Đóng"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <!-- Body -->
    <div class="modal-body" id="modalBody">
      <div class="modal-loading">
        <div class="modal-spinner"></div>
        <span>Đang tải thông tin khóa học…</span>
      </div>
    </div>

  </div>
</div>

<script>
  // ── Progress bar animation ──────────────────────────────
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.progress-fill').forEach(function (el) {
      const target = el.style.width;
      el.style.width = '0';
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          el.style.width = target;
        });
      });
    });

    const observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'translateY(0)';
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08 });

    document.querySelectorAll('.course-card').forEach(function (card) {
      observer.observe(card);
    });
  });

  // ── Modal helpers ───────────────────────────────────────
  function openModal() {
    const overlay = document.getElementById('courseDetailModal');
    overlay.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    overlay.focus();
  }

  function closeModal() {
    const overlay = document.getElementById('courseDetailModal');
    overlay.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  function handleModalOverlayClick(e) {
    if (e.target === document.getElementById('courseDetailModal')) {
      closeModal();
    }
  }

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeModal();
  });

  // ── Format date ─────────────────────────────────────────
  function formatDate(str) {
    if (!str) return 'Chưa xác định';
    const d = new Date(str);
    if (isNaN(d)) return str;
    return d.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
  }

  // ── Open & fetch course detail ──────────────────────────
  function openCourseDetail(courseId, courseName) {
    // Reset header
    document.getElementById('modalCourseIcon').textContent = (courseName || '?').charAt(0).toUpperCase();
    document.getElementById('modalCourseTitle').textContent = courseName || 'Khóa học';
    document.getElementById('modalCourseTags').innerHTML = '';

    // Show loading state
    document.getElementById('modalBody').innerHTML = `
      <div class="modal-loading">
        <div class="modal-spinner"></div>
        <span>Đang tải thông tin khóa học…</span>
      </div>`;

    openModal();

    fetch('/student/courses/' + courseId + '/details', {
      credentials: 'same-origin'
    })
      .then(function (res) {
        if (!res.ok) throw new Error('HTTP ' + res.status);
        return res.json();
      })
      .then(function (data) {
        renderModal(data);
      })
      .catch(function (err) {
        document.getElementById('modalBody').innerHTML = `
          <div class="modal-loading" style="color:#be123c;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span>Không thể tải thông tin khóa học.<br><small style="color:#9ca3af;">${err.message}</small></span>
          </div>`;
      });
  }

  // ── Render fetched data into modal ──────────────────────
  function renderModal(data) {
    const c    = data.course     || {};
    const secs = data.sections   || [];
    const quizzes = data.quizzes || [];
    const prereqs = data.prerequisites || [];

    // Update header tags
    const tagsEl = document.getElementById('modalCourseTags');
    tagsEl.innerHTML = '';
    if (c.Subject_name) tagsEl.innerHTML += `<span class="modal-tag modal-tag-indigo">📖 ${escHtml(c.Subject_name)}</span>`;
    if (c.Dept_name)    tagsEl.innerHTML += `<span class="modal-tag modal-tag-violet">🏫 ${escHtml(c.Dept_name)}</span>`;
    if (c.Credits)      tagsEl.innerHTML += `<span class="modal-tag modal-tag-teal">⭐ ${escHtml(c.Credits)} tín chỉ</span>`;

    // Count totals
    const totalLectures = secs.reduce(function (sum, s) { return sum + (s.lectures ? s.lectures.length : 0); }, 0);
    const totalChapters = secs.length;

    // ── Info grid ──
    let html = `
      <div class="modal-info-grid">
        <div class="modal-info-item">
          <div class="modal-info-label">👨‍🏫 Giảng viên</div>
          <div class="modal-info-value">${escHtml(c.Lecturer_name || 'Chưa xác định')}</div>
        </div>
        <div class="modal-info-item">
          <div class="modal-info-label">🏛️ Khoa</div>
          <div class="modal-info-value">${escHtml(c.Dept_name || '—')}</div>
        </div>
        <div class="modal-info-item">
          <div class="modal-info-label">⭐ Tín chỉ</div>
          <div class="modal-info-value">${escHtml(String(c.Credits ?? '—'))}</div>
        </div>
        <div class="modal-info-item">
          <div class="modal-info-label">📚 Số học phần</div>
          <div class="modal-info-value">${totalChapters} học phần</div>
        </div>
        <div class="modal-info-item">
          <div class="modal-info-label">🎬 Bài giảng</div>
          <div class="modal-info-value">${totalLectures} bài</div>
        </div>
        <div class="modal-info-item">
          <div class="modal-info-label">📝 Bài quiz</div>
          <div class="modal-info-value">${quizzes.length} bài</div>
        </div>
      </div>`;

    // ── Description ──
    if (c.Description) {
      html += `
        <div class="modal-section-title">📋 Mô tả khóa học</div>
        <div class="modal-desc-block">${escHtml(c.Description)}</div>`;
    }

    // ── Chapters & Lectures ──
    html += `<div class="modal-section-title">📖 Nội dung khóa học</div>`;
    if (secs.length === 0) {
      html += `<p class="prereq-none" style="margin-bottom:22px;">Chưa có học phần nào.</p>`;
    } else {
      html += `<div class="chapter-list">`;
      secs.forEach(function (sec, idx) {
        const lecCount = sec.lectures ? sec.lectures.length : 0;
        const isFirst = idx === 0;
        html += `
          <div class="chapter-item${isFirst ? ' is-open' : ''}" id="chapter-${idx}">
            <div class="chapter-header" onclick="toggleChapter('chapter-${idx}')">
              <div class="chapter-num">${sec.Section_order || (idx + 1)}</div>
              <div class="chapter-name">${escHtml(sec.Section_name || ('Học phần ' + (idx + 1)))}</div>
              <span class="chapter-lecture-count">${lecCount} bài giảng</span>
              <svg class="chapter-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
            <div class="chapter-lectures">`;

        if (!sec.lectures || sec.lectures.length === 0) {
          html += `<p class="lecture-empty">Chưa có bài giảng trong học phần này.</p>`;
        } else {
          sec.lectures.forEach(function (lec) {
            html += `
              <div class="lecture-row">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                ${escHtml(lec)}
              </div>`;
          });
        }

        html += `</div></div>`;
      });
      html += `</div>`;
    }

    // ── Quizzes ──
    html += `<div class="modal-section-title">📝 Danh sách bài quiz</div>`;
    if (quizzes.length === 0) {
      html += `<p class="prereq-none" style="margin-bottom:22px;">Chưa có bài quiz nào.</p>`;
    } else {
      html += `<div class="quiz-list">`;
      quizzes.forEach(function (q, i) {
        html += `
          <div class="quiz-row">
            <div class="quiz-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            </div>
            <div class="quiz-info">
              <div class="quiz-title">${escHtml(q.Quiz_title || ('Quiz ' + (i + 1)))}</div>
              <div class="quiz-meta-row">
                <span>🏆 Điểm tối đa: <strong>${q.Max_score ?? '—'}</strong></span>
                <span>⏱️ Thời gian: <strong>${q.Duration ? q.Duration + ' phút' : '—'}</strong></span>
              </div>
            </div>
          </div>`;
      });
      html += `</div>`;
    }

    // ── Prerequisites ──
    html += `<div class="modal-section-title">🔑 Môn tiên quyết</div>`;
    if (prereqs.length === 0) {
      html += `<p class="prereq-none">Không có môn tiên quyết — tất cả sinh viên đều có thể đăng ký.</p>`;
    } else {
      html += `<div class="prereq-list">`;
      prereqs.forEach(function (p) {
        html += `<span class="prereq-chip"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>${escHtml(p)}</span>`;
      });
      html += `</div>`;
    }

    // ── Dates ──
    html += `
      <div class="modal-section-title">📅 Thời gian khóa học</div>
      <div class="modal-dates-grid">
        <div class="modal-date-card modal-date-card-start">
          <div class="modal-date-icon modal-date-icon-start">🚀</div>
          <div>
            <div class="modal-date-label">Ngày bắt đầu</div>
            <div class="modal-date-value">${formatDate(c.Start_date)}</div>
          </div>
        </div>
        <div class="modal-date-card modal-date-card-end">
          <div class="modal-date-icon modal-date-icon-end">🏁</div>
          <div>
            <div class="modal-date-label">Ngày kết thúc</div>
            <div class="modal-date-value">${formatDate(c.End_date)}</div>
          </div>
        </div>
      </div>`;

    document.getElementById('modalBody').innerHTML = html;
  }

  // ── Toggle chapter accordion ────────────────────────────
  function toggleChapter(id) {
    const el = document.getElementById(id);
    if (el) el.classList.toggle('is-open');
  }

  // ── HTML escape helper ──────────────────────────────────
  function escHtml(str) {
    return String(str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }
</script>
</body>
</html>
