              <th scope="col">Khoa</th>
              <th scope="col">Giảng viên</th>
              <th scope="col">Tín chỉ</th>
              <th scope="col">Thao tác</th>
            </tr>
          </thead>

          <tbody>
            <% if (courseList.length === 0) { %>
              <tr class="empty-table-row">
                <td colspan="7">
                  <div style="display:flex;flex-direction:column;align-items:center;gap:8px;color:#9ca3af;">
                    <span style="font-size:28px;">🎓</span>
                    Hiện không có khóa học mới để đăng ký.
                  </div>
                </td>
              </tr>
            <% } %>

            <% courseList.forEach(c => { %>
              <tr>
                <td class="td-id"><%= c.Course_ID %></td>

                <td class="course-name-cell">
                  <strong><%= c.Course_name %></strong>
                  <small><%= c.Description || '' %></small>
                </td>

                <td><%= c.Subject_name %></td>
                <td><%= c.Dept_name %></td>
                <td><%= c.Lecturer_display_name || c.Lecturer_name %></td>

                <td>
                  <span class="credit-badge" title="<%= c.Credits %> tín chỉ">
