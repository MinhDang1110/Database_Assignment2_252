<!DOCTYPE html>

<html lang="vi">

<head>

  <meta charset="UTF-8">
  <title>LMS EduGate - Đăng nhập</title>

  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    /* ─── DESIGN TOKENS ────────────────────────────────── */
    :root {
      /* Brand */
      --indigo-900: #1e1b4b;
      --indigo-800: #2e2a6e;
      --indigo-600: #4f46e5;
      --indigo-500: #6366f1;
      --indigo-400: #818cf8;
      --indigo-300: #a5b4fc;
      --violet-500: #8b5cf6;
      --violet-400: #a78bfa;
      --teal-400: #2dd4bf;
      --teal-300: #5eead4;
      --amber-400: #fbbf24;
      --amber-300: #fcd34d;
      --rose-500: #f43f5e;

      /* Panel */
      --panel-bg: #0d0b1e;
      --form-bg: #ffffff;
      --glass-bg: rgba(255,255,255,0.06);
      --glass-border: rgba(255,255,255,0.10);
      --card-bg: rgba(255,255,255,0.08);

      /* Text */
      --text-light: #f1f0fe;
      --text-soft: #a0a8c8;
      --text-muted: #6b7191;
      --text-dark: #0f0e1e;
      --text-body: #374151;
      --text-label: #4b5563;

      /* Form */
      --input-bg: #f8f9ff;
      --input-border: #e0e3f0;
      --input-border-focus: #6366f1;
      --input-shadow-focus: rgba(99, 102, 241, 0.15);

      --success-bg: #f0fdf4;
      --success-border: #86efac;
      --success-text: #166534;
      --danger-bg: #fff1f2;
      --danger-border: #fda4af;
      --danger-text: #be123c;

      /* Radii */
      --r-xl: 32px;
      --r-lg: 22px;
      --r-md: 16px;
      --r-sm: 12px;
      --r-xs: 8px;

      /* Shadows */
      --shadow-deep: 0 40px 80px rgba(0,0,0,0.45), 0 0 0 1px rgba(255,255,255,0.04);
      --shadow-card: 0 8px 32px rgba(0,0,0,0.28);
      --shadow-btn: 0 12px 32px rgba(99,102,241,0.38);
      --shadow-btn-hover: 0 18px 40px rgba(99,102,241,0.52);
    }

    /* ─── RESET ────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }

    body {
      font-family: "Be Vietnam Pro", "Segoe UI", system-ui, sans-serif;
      background: var(--panel-bg);
      color: var(--text-dark);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: geometricPrecision;
      line-height: 1.6;
      overflow-x: hidden;
    }

    /* ─── PAGE SHELL ───────────────────────────────────── */
    .page-shell {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(ellipse 80% 60% at 10% 10%, rgba(99,102,241,0.18) 0%, transparent 60%),
        radial-gradient(ellipse 60% 50% at 90% 90%, rgba(139,92,246,0.14) 0%, transparent 55%),
        radial-gradient(ellipse 50% 40% at 50% 50%, rgba(45,212,191,0.06) 0%, transparent 60%),
        #0d0b1e;
    }

    /* Floating orbs background */
    .orb {
      position: absolute;
      border-radius: 999px;
      pointer-events: none;
      filter: blur(80px);
      animation: orb-drift 12s ease-in-out infinite alternate;
    }
    .orb-1 { width: 420px; height: 420px; top: -140px; left: -100px; background: rgba(99,102,241,0.16); animation-delay: 0s; }
    .orb-2 { width: 360px; height: 360px; bottom: -100px; right: -80px; background: rgba(139,92,246,0.14); animation-delay: -4s; }
    .orb-3 { width: 220px; height: 220px; top: 40%; left: 42%; background: rgba(45,212,191,0.08); animation-delay: -8s; }

    @keyframes orb-drift {
      from { transform: translate(0, 0) scale(1); }
      to   { transform: translate(30px, -20px) scale(1.06); }
    }

    /* Noise texture overlay */
    .page-shell::after {
      content: "";
      position: absolute;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.035'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
    }

    /* ─── LOGIN LAYOUT ─────────────────────────────────── */
    .login-layout {
      width: min(1200px, 100%);
      min-height: 700px;
      display: grid;
      grid-template-columns: 1.08fr 0.92fr;
      border-radius: var(--r-xl);
      overflow: hidden;
      position: relative;
      z-index: 1;
      box-shadow: var(--shadow-deep);
      border: 1px solid rgba(255,255,255,0.07);

      /* Page entrance animation */
      animation: entrance 0.72s cubic-bezier(0.16,1,0.3,1) both;
    }

    @keyframes entrance {
      from { opacity: 0; transform: translateY(28px) scale(0.97); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* ═══════════════════════════════════════════════════
       LEFT PANEL — Dark immersive
    ═══════════════════════════════════════════════════ */
    .visual-panel {
      position: relative;
      padding: 44px 48px 40px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
      background:
        radial-gradient(ellipse 100% 70% at 0% 0%, rgba(99,102,241,0.22) 0%, transparent 55%),
        radial-gradient(ellipse 80% 60% at 100% 100%, rgba(139,92,246,0.18) 0%, transparent 50%),
        radial-gradient(ellipse 60% 40% at 60% 30%, rgba(45,212,191,0.07) 0%, transparent 40%),
        linear-gradient(160deg, #13112a 0%, #0f0d24 50%, #110e28 100%);
    }

    /* Grid lines decoration */
    .visual-panel::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,0.024) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.024) 1px, transparent 1px);
      background-size: 52px 52px;
      pointer-events: none;
    }

    /* ── Brand ── */
    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
      position: relative;
      z-index: 2;
    }

    .brand-logo {
      width: 46px;
      height: 46px;
      border-radius: 14px;
      background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 60%, #2dd4bf 100%);
      color: white;
      display: grid;
      place-items: center;
      font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
      font-weight: 800;
      font-size: 20px;
      box-shadow: 0 8px 24px rgba(99,102,241,0.50), inset 0 1px 0 rgba(255,255,255,0.25);
      position: relative;
      flex-shrink: 0;
    }

    .brand-logo::after {
      content: "";
      position: absolute;
      inset: -2px;
      border-radius: 16px;
      background: linear-gradient(135deg, rgba(99,102,241,0.5), rgba(139,92,246,0.3), rgba(45,212,191,0.4));
      z-index: -1;
      filter: blur(6px);
    }

    .brand-text strong {
      display: block;
      font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
      font-size: 17px;
      font-weight: 700;
      color: #f1f0fe;
      letter-spacing: -0.01em;
    }
    .brand-text span {
      display: block;
      font-size: 12.5px;
      color: var(--text-soft);
      margin-top: 2px;
    }

    /* ── Hero copy ── */
    .hero-copy {
      position: relative;
      z-index: 2;
      margin-top: 38px;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 14px;
      background: rgba(99,102,241,0.15);
      border: 1px solid rgba(99,102,241,0.30);
      color: var(--indigo-300);
      border-radius: 999px;
      font-size: 12.5px;
      font-weight: 600;
      margin-bottom: 22px;
      letter-spacing: 0.01em;
      backdrop-filter: blur(8px);
    }

    .hero-badge-dot {
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: var(--teal-400);
      box-shadow: 0 0 8px rgba(45,212,191,0.8);
      animation: pulse-dot 2.4s ease-in-out infinite;
    }

    @keyframes pulse-dot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.6; transform: scale(0.75); }
    }

    .hero-title {
      font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
      font-size: clamp(32px, 3.6vw, 50px);
      line-height: 1.08;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: var(--text-light);
    }

    .hero-title .highlight {
      display: block;
      background: linear-gradient(90deg, #818cf8 0%, #a78bfa 40%, #2dd4bf 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-top: 4px;
    }

    .hero-desc {
      margin-top: 18px;
      color: #7b83a8;
      font-size: 14.5px;
      line-height: 1.8;
      max-width: 420px;
    }

    /* ── Illustration ── */
    .hero-illustration-wrap {
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 24px 0 16px;
      position: relative;
      z-index: 2;
    }

    .hero-illustration {
      width: min(100%, 460px);
      height: 320px;
      position: relative;
    }

    /* Base glow platform */
    .blob-main {
      position: absolute;
      inset: 20px 24px 16px 24px;
      border-radius: 28px;
      background: linear-gradient(140deg, rgba(99,102,241,0.12), rgba(45,212,191,0.06));
      border: 1px solid rgba(255,255,255,0.07);
      backdrop-filter: blur(4px);
    }

    /* Screen cards */
    .screen-card {
      position: absolute;
      border-radius: 18px;
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.10);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      box-shadow: 0 20px 48px rgba(0,0,0,0.36);
      transition: transform 0.3s ease;
    }

    .screen-main {
      width: 230px;
      height: 148px;
      left: 80px;
      top: 70px;
      padding: 16px 18px;
      animation: float-a 6s ease-in-out infinite;
    }

    .screen-small {
      width: 144px;
      height: 106px;
      right: 44px;
      top: 36px;
      padding: 14px;
      animation: float-b 7s ease-in-out infinite;
    }

    .screen-bottom {
      width: 160px;
      height: 110px;
      right: 52px;
      bottom: 26px;
      padding: 14px;
      animation: float-c 8s ease-in-out infinite;
    }

    @keyframes float-a {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-8px); }
    }
    @keyframes float-b {
      0%, 100% { transform: translateY(0px) rotate(0.5deg); }
      50% { transform: translateY(-6px) rotate(-0.5deg); }
    }
    @keyframes float-c {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }

    /* Card internals */
    .card-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
    }

    .avatar-chip {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: linear-gradient(135deg, #6366f1, #8b5cf6);
      flex-shrink: 0;
      box-shadow: 0 4px 12px rgba(99,102,241,0.40);
    }

    .card-title-lines { flex: 1; }

    .screen-bar {
      height: 7px;
      border-radius: 999px;
      background: rgba(255,255,255,0.10);
      margin-bottom: 8px;
    }
    .screen-bar:last-child { margin-bottom: 0; }
    .screen-bar.w70 { width: 70%; }
    .screen-bar.w50 { width: 50%; }
    .screen-bar.w85 { width: 85%; background: rgba(99,102,241,0.45); }
    .screen-bar.w60 { width: 60%; background: rgba(45,212,191,0.40); }
    .screen-bar.w40 { width: 40%; }

    .progress-track {
      width: 100%;
      height: 6px;
      border-radius: 999px;
      background: rgba(255,255,255,0.10);
      margin-top: 12px;
      overflow: hidden;
    }
    .progress-fill {
      height: 100%;
      width: 68%;
      border-radius: inherit;
      background: linear-gradient(90deg, #6366f1, #2dd4bf);
      animation: progress-grow 2.4s cubic-bezier(0.4,0,0.2,1) both 0.8s;
    }
    @keyframes progress-grow {
      from { width: 0; }
      to   { width: 68%; }
    }

    /* Floating badges */
    .floating-badge {
      position: absolute;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(15,13,36,0.80);
      border: 1px solid rgba(255,255,255,0.12);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-radius: 999px;
      padding: 9px 16px;
      box-shadow: 0 12px 32px rgba(0,0,0,0.32);
      font-size: 12.5px;
      font-weight: 600;
      color: var(--text-light);
      white-space: nowrap;
      z-index: 10;
    }

    .floating-badge.one {
      left: 30px;
      bottom: 38px;
      animation: badge-float-a 5s ease-in-out infinite;
    }
    .floating-badge.two {
      right: 14px;
      top: 156px;
      animation: badge-float-b 6s ease-in-out infinite;
    }

    @keyframes badge-float-a {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-5px); }
    }
    @keyframes badge-float-b {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(5px); }
    }

    .badge-icon {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      font-size: 11px;
      flex-shrink: 0;
    }

    .badge-icon.green {
      background: rgba(45,212,191,0.20);
      color: var(--teal-300);
      box-shadow: 0 0 10px rgba(45,212,191,0.30);
    }

    .badge-icon.purple {
      background: rgba(167,139,250,0.20);
      color: var(--violet-400);
      box-shadow: 0 0 10px rgba(167,139,250,0.30);
    }

    /* ── Visual footer stats ── */
    .visual-footer {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      position: relative;
      z-index: 2;
    }

    .stat-box {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: var(--r-md);
      padding: 16px 14px;
      backdrop-filter: blur(8px);
      transition: background 0.22s ease, border-color 0.22s ease, transform 0.22s ease;
    }

    .stat-box:hover {
      background: rgba(255,255,255,0.09);
      border-color: rgba(99,102,241,0.30);
      transform: translateY(-2px);
    }

    .stat-box strong {
      display: block;
      font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
      font-size: 21px;
      font-weight: 800;
      color: var(--text-light);
      letter-spacing: -0.02em;
      background: linear-gradient(135deg, #f1f0fe, #a5b4fc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .stat-box span {
      font-size: 11.5px;
      color: var(--text-muted);
      margin-top: 4px;
      display: block;
    }

    /* ═══════════════════════════════════════════════════
       RIGHT PANEL — Clean white form
    ═══════════════════════════════════════════════════ */
    .form-panel {
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 52px 48px;
      position: relative;
    }

    /* Subtle top accent bar */
    .form-panel::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, #6366f1, #8b5cf6, #2dd4bf);
    }

    .form-card {
      width: min(100%, 420px);
    }

    /* ── Form header ── */
    .form-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--indigo-500);
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.10em;
      margin-bottom: 10px;
    }

    .form-eyebrow::before {
      content: "";
      display: block;
      width: 18px;
      height: 2px;
      border-radius: 1px;
      background: linear-gradient(90deg, #6366f1, #8b5cf6);
    }

    .form-title {
      font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
      font-size: 32px;
      font-weight: 800;
      letter-spacing: -0.035em;
      color: #0f0e1e;
      line-height: 1.1;
    }

    .form-subtitle {
      margin-top: 10px;
      margin-bottom: 28px;
      color: #6b7280;
      font-size: 14px;
      line-height: 1.75;
    }

    /* ── Alerts ── */
    .alert {
      border-radius: var(--r-sm);
      padding: 12px 16px;
      border: 1px solid transparent;
      font-size: 14px;
      line-height: 1.5;
      margin-bottom: 16px;
      display: flex;
      align-items: flex-start;
      gap: 10px;
      animation: alert-in 0.35s cubic-bezier(0.16,1,0.3,1);
    }

    @keyframes alert-in {
      from { opacity: 0; transform: translateY(-6px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .alert::before {
      content: "";
      flex-shrink: 0;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      margin-top: 1px;
      background-size: contain;
    }

    .alert-success {
      background: var(--success-bg);
      border-color: var(--success-border);
      color: var(--success-text);
    }
    .alert-success::before {
      background: url("data:image/svg+xml,%3Csvg viewBox='0 0 20 20' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='10' cy='10' r='9' stroke='%2316a34a' stroke-width='1.5'/%3E%3Cpath d='M6.5 10.5l2.5 2.5 4.5-5' stroke='%2316a34a' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E") center/contain no-repeat;
    }

    .alert-danger {
      background: var(--danger-bg);
      border-color: var(--danger-border);
      color: var(--danger-text);
    }
    .alert-danger::before {
      background: url("data:image/svg+xml,%3Csvg viewBox='0 0 20 20' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='10' cy='10' r='9' stroke='%23be123c' stroke-width='1.5'/%3E%3Cpath d='M10 6v4.5M10 13.5v.5' stroke='%23be123c' stroke-width='1.5' stroke-linecap='round'/%3E%3C/svg%3E") center/contain no-repeat;
    }

    /* ── Divider ── */
    .divider {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 4px 0 22px;
      color: #9ca3af;
      font-size: 12.5px;
      font-weight: 500;
    }
    .divider::before, .divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: #f0f1f5;
    }

    /* ── Fields ── */
    .field {
      margin-bottom: 18px;
    }

    .field label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-label);
      margin-bottom: 7px;
      transition: color 0.18s;
    }

    .field:focus-within label {
      color: var(--indigo-600);
    }

    .input-wrap {
      position: relative;
    }

    /* Glow ring on focus */
    .input-wrap::after {
      content: "";
      position: absolute;
      inset: -3px;
      border-radius: 18px;
      background: linear-gradient(135deg, #6366f1, #8b5cf6);
      z-index: -1;
      opacity: 0;
      transition: opacity 0.22s ease;
    }
    .input-wrap:focus-within::after {
      opacity: 0.14;
    }

    .input-icon {
      position: absolute;
      top: 50%;
      left: 15px;
      transform: translateY(-50%);
      width: 19px;
      height: 19px;
      color: #9ca3af;
      pointer-events: none;
      transition: color 0.2s ease;
    }

    .input-wrap:focus-within .input-icon {
      color: var(--indigo-500);
    }

    .input {
      width: 100%;
      height: 52px;
      border: 1.5px solid var(--input-border);
      background: var(--input-bg);
      border-radius: 15px;
      padding: 0 14px 0 46px;
      font-family: inherit;
      font-size: 14.5px;
      color: #111827;
      outline: none;
      transition:
        border-color 0.20s ease,
        box-shadow 0.20s ease,
        background 0.20s ease;
    }

    .input::placeholder { color: #b0b7c9; }

    .input:focus {
      background: #ffffff;
      border-color: var(--indigo-500);
      box-shadow: 0 0 0 4px var(--input-shadow-focus);
    }

    .input:not(:placeholder-shown):not(:focus) {
      border-color: #d1d5db;
      background: #fff;
    }

    /* Inline validation feedback via CSS */
    .input:required:not(:placeholder-shown):invalid {
      border-color: #fca5a5;
    }

    .password-input { padding-right: 50px; }

    .toggle-password {
      position: absolute;
      top: 50%;
      right: 8px;
      transform: translateY(-50%);
      width: 36px;
      height: 36px;
      border: none;
      background: transparent;
      border-radius: 10px;
      cursor: pointer;
      color: #9ca3af;
      display: grid;
      place-items: center;
      transition: background 0.16s ease, color 0.16s ease;
    }

    .toggle-password:hover {
      background: rgba(99,102,241,0.08);
      color: var(--indigo-500);
    }

    .toggle-password:focus-visible {
      outline: 2px solid var(--indigo-400);
      outline-offset: 2px;
    }

    /* ── Remember / Forgot row ── */
    .row-between {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin: 6px 0 24px;
      flex-wrap: wrap;
    }

    .remember-me {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      font-size: 13.5px;
      color: #4b5563;
      cursor: pointer;
      user-select: none;
    }

    /* Custom checkbox */
    .remember-me input[type="checkbox"] {
      appearance: none;
      -webkit-appearance: none;
      width: 17px;
      height: 17px;
      border: 1.5px solid #d1d5db;
      border-radius: 5px;
      background: white;
      cursor: pointer;
      transition: border-color 0.16s, background 0.16s, box-shadow 0.16s;
      position: relative;
      flex-shrink: 0;
    }

    .remember-me input[type="checkbox"]:checked {
      background: var(--indigo-500);
      border-color: var(--indigo-500);
      box-shadow: 0 2px 8px rgba(99,102,241,0.30);
    }

    .remember-me input[type="checkbox"]:checked::after {
      content: "";
      position: absolute;
      top: 2px;
      left: 5px;
      width: 5px;
      height: 9px;
      border: 2px solid white;
      border-top: none;
      border-left: none;
      transform: rotate(45deg);
    }

    .remember-me input[type="checkbox"]:focus-visible {
      outline: 2px solid var(--indigo-400);
      outline-offset: 2px;
    }

    .link {
      color: var(--indigo-500);
      text-decoration: none;
      font-size: 13.5px;
      font-weight: 600;
      transition: color 0.16s ease;
      position: relative;
    }

    .link::after {
      content: "";
      position: absolute;
      bottom: -1px;
      left: 0;
      right: 0;
      height: 1.5px;
      background: var(--indigo-400);
      transform: scaleX(0);
      transition: transform 0.2s ease;
    }

    .link:hover { color: #4338ca; }
    .link:hover::after { transform: scaleX(1); }

    /* ── Submit button ── */
    .submit-btn {
      width: 100%;
      height: 54px;
      border: none;
      border-radius: 15px;
      background: linear-gradient(135deg, #4f46e5 0%, #6366f1 50%, #8b5cf6 100%);
      background-size: 200% 200%;
      background-position: 0% 50%;
      color: white;
      font-family: inherit;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.01em;
      cursor: pointer;
      box-shadow: var(--shadow-btn);
      transition:
        background-position 0.4s ease,
        transform 0.20s ease,
        box-shadow 0.20s ease;
      position: relative;
      overflow: hidden;
    }

    /* Shimmer sweep on hover */
    .submit-btn::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 60%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
      transform: skewX(-15deg);
      transition: left 0.5s ease;
    }

    .submit-btn:hover {
      background-position: 100% 50%;
      transform: translateY(-2px);
      box-shadow: var(--shadow-btn-hover);
    }

    .submit-btn:hover::before { left: 140%; }

    .submit-btn:active {
      transform: translateY(0);
      box-shadow: var(--shadow-btn);
    }

    .submit-btn:focus-visible {
      outline: 3px solid rgba(99,102,241,0.50);
      outline-offset: 3px;
    }

    .submit-btn.is-loading {
      color: transparent;
      pointer-events: none;
      background-position: 0% 50%;
    }

    .submit-btn.is-loading::after {
      content: "";
      position: absolute;
      width: 22px;
      height: 22px;
      top: calc(50% - 11px);
      left: calc(50% - 11px);
      border-radius: 999px;
      border: 2.5px solid rgba(255,255,255,0.35);
      border-top-color: #fff;
      animation: spin 0.7s linear infinite;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    /* ── Footer links ── */
    .register-text {
      margin-top: 22px;
      text-align: center;
      color: #6b7280;
      font-size: 14px;
    }

    .register-text a {
      color: var(--indigo-500);
      text-decoration: none;
      font-weight: 700;
      transition: color 0.16s;
    }

    .register-text a:hover { color: #4338ca; }

    .copyright {
      margin-top: 20px;
      text-align: center;
      font-size: 12px;
      color: #b0b7c9;
    }

    /* ─── RESPONSIVE ───────────────────────────────────── */
    @media (max-width: 1024px) {
      .login-layout {
        grid-template-columns: 1fr;
        max-width: 560px;
      }

      .visual-panel {
        padding: 36px 32px 32px;
        min-height: 400px;
      }

      .visual-footer {
        max-width: 480px;
      }

      .form-panel {
        padding: 40px 32px 44px;
      }

      .hero-illustration { height: 270px; }

      .screen-main { width: 198px; height: 132px; left: 66px; top: 60px; }
      .screen-small { width: 130px; height: 96px; right: 32px; }
      .screen-bottom { width: 146px; height: 100px; right: 38px; }
      .floating-badge.two { right: 6px; top: 140px; }
    }

    @media (max-width: 640px) {
      .page-shell { padding: 12px; }

      .login-layout {
        border-radius: 24px;
        min-height: auto;
      }

      .visual-panel {
        padding: 28px 22px 26px;
      }

      .hero-title { font-size: 28px; }
      .hero-desc { display: none; }

      .hero-illustration { height: 240px; }

      .screen-main { width: 172px; height: 118px; left: 44px; top: 56px; }
      .screen-small { width: 114px; height: 84px; right: 14px; top: 28px; }
      .screen-bottom { width: 128px; height: 90px; right: 18px; bottom: 18px; }
      .floating-badge.one { left: 14px; bottom: 26px; font-size: 11.5px; padding: 7px 12px; }
      .floating-badge.two { right: 2px; top: 132px; font-size: 11.5px; padding: 7px 12px; }

      .visual-footer { grid-template-columns: repeat(3, 1fr); gap: 8px; }
      .stat-box { padding: 12px 10px; }
      .stat-box strong { font-size: 18px; }

      .form-panel { padding: 28px 20px 36px; }
      .form-title { font-size: 26px; }
      .form-subtitle { font-size: 13.5px; }
    }

    @media (max-width: 380px) {
      .visual-panel { padding: 24px 16px 22px; }
      .form-panel { padding: 22px 16px 32px; }
      .screen-main { left: 30px; width: 158px; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation: none !important;
        transition: none !important;
      }
    }
  </style>
</head>

<body>
  <main class="page-shell" role="main">

    <!-- Background orbs -->
    <div class="orb orb-1" aria-hidden="true"></div>
    <div class="orb orb-2" aria-hidden="true"></div>
    <div class="orb orb-3" aria-hidden="true"></div>

    <section class="login-layout" aria-label="Trang đăng nhập EduGate">

      <!-- ════════════════════════════════════
           LEFT — Visual / Brand panel
      ════════════════════════════════════ -->
      <aside class="visual-panel" aria-hidden="true">

        <div>
          <!-- Brand -->
          <div class="brand">
            <div class="brand-logo">E</div>
            <div class="brand-text">
              <strong>LMS EduGate</strong>
              <span>Hệ thống quản lý học tập hiện đại</span>
            </div>
          </div>

          <!-- Hero copy -->
          <div class="hero-copy">
            <div class="hero-badge">
              <span class="hero-badge-dot"></span>
              Nền tảng học tập trực tuyến thông minh
            </div>

            <h1 class="hero-title">
              Học tập hiệu quả hơn
              <span class="highlight">trong không gian số.</span>
            </h1>

            <p class="hero-desc">
              Truy cập bài giảng, khóa học, bài kiểm tra và tiến độ học tập trên một giao diện trực quan, thân thiện và tối ưu cho cả sinh viên lẫn giảng viên.
            </p>
          </div>
        </div>

        <!-- Illustration -->
        <div class="hero-illustration-wrap">
          <div class="hero-illustration">
            <div class="blob-main"></div>

            <!-- Main course card -->
            <div class="screen-card screen-main">
              <div class="card-header">
                <div class="avatar-chip"></div>
                <div class="card-title-lines">
                  <div class="screen-bar w85"></div>
                  <div class="screen-bar w50"></div>
                </div>
              </div>
              <div class="screen-bar w70"></div>
              <div class="screen-bar w40"></div>
              <div class="progress-track">
                <div class="progress-fill"></div>
              </div>
            </div>

            <!-- Stats card -->
            <div class="screen-card screen-small">
              <div class="screen-bar w60"></div>
              <div class="screen-bar w85"></div>
              <div class="screen-bar w40"></div>
              <div class="screen-bar w70"></div>
            </div>

            <!-- Assignment card -->
            <div class="screen-card screen-bottom">
              <div class="screen-bar w85"></div>
              <div class="screen-bar w60"></div>
              <div class="screen-bar w40"></div>
              <div class="screen-bar w70"></div>
            </div>

            <!-- Floating badge 1 -->
            <div class="floating-badge one">
              <span class="badge-icon green">✓</span>
              Học mọi lúc, mọi nơi
            </div>

            <!-- Floating badge 2 -->
            <div class="floating-badge two">
              <span class="badge-icon purple">✦</span>
              Giao diện trực quan
            </div>
          </div>
        </div>

        <!-- Stats footer -->
        <div class="visual-footer">
          <div class="stat-box">
            <strong>24/7</strong>
            <span>Truy cập linh hoạt</span>
          </div>
          <div class="stat-box">
            <strong>LMS</strong>
            <span>Học tập hiệu quả</span>
          </div>
          <div class="stat-box">
            <strong>Smart</strong>
            <span>Quản lý dễ dàng</span>
          </div>
        </div>

      </aside>

      <!-- ════════════════════════════════════
           RIGHT — Login form
      ════════════════════════════════════ -->
      <section class="form-panel">
        <div class="form-card">

          <div class="form-eyebrow">Đăng nhập hệ thống</div>
          <h2 class="form-title">Chào mừng bạn trở lại</h2>
          <p class="form-subtitle">
            Đăng nhập vào LMS EduGate để tiếp tục học tập, giảng dạy và quản lý khóa học một cách thuận tiện.
          </p>

          <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success" role="alert"><%= success %></div>
          <% } %>

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger" role="alert"><%= error %></div>
          <% } %>

          <div class="divider">Đăng nhập</div>

          <form id="loginForm" method="POST" action="/login" autocomplete="on" novalidate>

            <div class="field">
              <label for="username_or_email">Tên đăng nhập / Email</label>
              <div class="input-wrap">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M4 7.75A2.75 2.75 0 0 1 6.75 5h10.5A2.75 2.75 0 0 1 20 7.75v8.5A2.75 2.75 0 0 1 17.25 19H6.75A2.75 2.75 0 0 1 4 16.25v-8.5Z" stroke="currentColor" stroke-width="1.6"/>
                  <path d="m5.25 7.25 5.21 4.15a2.45 2.45 0 0 0 3.08 0l5.21-4.15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
                <input
                  class="input"
                  id="username_or_email"
                  type="text"
                  name="username_or_email"
                  placeholder="Nhập tên đăng nhập hoặc email"
                  required
                  autocomplete="username"
                  aria-label="Tên đăng nhập hoặc địa chỉ email"
                >
              </div>
            </div>

            <div class="field">
              <label for="password">Mật khẩu</label>
              <div class="input-wrap">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M7.5 10V8.1A4.5 4.5 0 0 1 12 3.6a4.5 4.5 0 0 1 4.5 4.5V10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                  <path d="M6.75 10h10.5A2.75 2.75 0 0 1 20 12.75v4.5A2.75 2.75 0 0 1 17.25 20H6.75A2.75 2.75 0 0 1 4 17.25v-4.5A2.75 2.75 0 0 1 6.75 10Z" stroke="currentColor" stroke-width="1.6"/>
                  <path d="M12 14v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
                <input
                  class="input password-input"
                  id="password"
                  type="password"
                  name="password"
                  placeholder="Nhập mật khẩu của bạn"
                  required
                  autocomplete="current-password"
                  aria-label="Mật khẩu"
                >
                <button
                  class="toggle-password"
                  type="button"
                  id="togglePassword"
                  aria-label="Ẩn hoặc hiện mật khẩu"
                >
                  <svg id="eyeOpen" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M2.75 12s3.25-6 9.25-6 9.25 6 9.25 6-3.25 6-9.25 6-9.25-6-9.25-6Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M12 15.25A3.25 3.25 0 1 0 12 8.75a3.25 3.25 0 0 0 0 6.5Z" stroke="currentColor" stroke-width="1.6"/>
                  </svg>
                  <svg id="eyeClosed" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="display:none;">
                    <path d="m4 4 16 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    <path d="M9.75 6.55A8.8 8.8 0 0 1 12 6c6 0 9.25 6 9.25 6a14.6 14.6 0 0 1-2.12 2.79M6.72 7.93C4.15 9.57 2.75 12 2.75 12s3.25 6 9.25 6c1.3 0 2.48-.28 3.52-.72" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
            </div>

            <div class="row-between">
              <label class="remember-me">
                <input type="checkbox" name="remember_me" value="1">
                <span>Ghi nhớ tôi</span>
              </label>
              <a href="/forgot-password" class="link">Quên mật khẩu?</a>
            </div>

            <button id="submitButton" class="submit-btn" type="submit">
              Đăng nhập
            </button>

          </form>

          <div class="register-text">
            Chưa có tài khoản?
            <a href="/register">Đăng ký ngay</a>
          </div>

          <div class="copyright">
            © 2026 LMS EduGate. All rights reserved.
          </div>

        </div>
      </section>

    </section>
  </main>

  <script>
    // ── Toggle hiện / ẩn mật khẩu ──────────────────────
    const togglePassword = document.getElementById('togglePassword');
    const passwordInput  = document.getElementById('password');
    const eyeOpen        = document.getElementById('eyeOpen');
    const eyeClosed      = document.getElementById('eyeClosed');

    if (togglePassword && passwordInput) {
      togglePassword.addEventListener('click', function () {
        const isHidden = passwordInput.type === 'password';
        passwordInput.type = isHidden ? 'text' : 'password';
        eyeOpen.style.display   = isHidden ? 'none'  : 'block';
        eyeClosed.style.display = isHidden ? 'block' : 'none';
        togglePassword.setAttribute('aria-label', isHidden ? 'Ẩn mật khẩu' : 'Hiện mật khẩu');
      });
    }

    // ── Loading state khi submit ────────────────────────
    const loginForm    = document.getElementById('loginForm');
    const submitButton = document.getElementById('submitButton');

    if (loginForm && submitButton) {
      loginForm.addEventListener('submit', function () {
        submitButton.classList.add('is-loading');
        submitButton.setAttribute('aria-busy', 'true');
        submitButton.setAttribute('disabled', 'true');
      });
    }

    // ── Staggered field entrance animation ─────────────
    const fields = document.querySelectorAll('.field, .row-between, .submit-btn, .register-text');
    fields.forEach(function(el, i) {
      el.style.opacity = '0';
      el.style.transform = 'translateY(14px)';
      el.style.transition = 'opacity 0.45s ease, transform 0.45s ease';
      el.style.transitionDelay = (0.38 + i * 0.07) + 's';
      requestAnimationFrame(function() {
        requestAnimationFrame(function() {
          el.style.opacity = '1';
          el.style.transform = 'translateY(0)';
        });
      });
    });
  </script>
</body>
</html>
